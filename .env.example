# Backend API URL
VITE_API_URL=http://localhost:8080/api

# Kakao Maps JavaScript key — https://developers.kakao.com > 내 애플리케이션 > 앱 키
# 사이트 도메인에 http://localhost:5173 을 등록해야 지도가 로드됩니다.
VITE_KAKAO_MAP_KEY=

# 카카오 로그인용 JavaScript 키 (지도 키와 같은 앱이면 동일한 값이어도 됨).
# 내 애플리케이션 > 카카오 로그인 활성화, Redirect URI에 http://localhost:5173 등록,
# 동의항목에서 닉네임/카카오계정(이메일) 설정 필요.
VITE_KAKAO_APP_KEY=

# 네이버 로그인 — https://developers.naver.com > Application 등록
# 서비스 URL: http://localhost:5173, 콜백 URL: http://localhost:5173/oauth/naver/callback
VITE_NAVER_CLIENT_ID=
VITE_NAVER_CALLBACK_URL=http://localhost:5173/oauth/naver/callback

# Toss Payments client key — https://developers.tosspayments.com > 내 개발정보
# 비워두면 Toss가 공식 문서에 공개한 샌드박스 테스트 키로 동작합니다 (실제 결제는 발생하지 않음).
# 실 결제를 받으려면 라이브 키로 교체하고, 백엔드의 TOSS_SECRET_KEY도 같이 라이브 시크릿 키로 바꿔야 합니다.
VITE_TOSS_CLIENT_KEY=
